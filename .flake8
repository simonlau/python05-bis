[flake8]
# Enforce standard PEP 8 line length limit strictly
max-line-length = 88

# Check for deep code nesting and logical complexity (McCabe complexity)
max-complexity = 10

# Explicitly clear out Flake8's default ignore list to enable ALL rules
ignore =

# Enable specific structural rules that are often turned off by default
# E203: Whitespace before ':' (disabled only if using Black formatter compatibility)
# W503/W504: Line breaks before/after binary operators
extend-select = E,F,W,C

# Exclude typical auto-generated or external dependency directories
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    dist,
    build,
    docs
